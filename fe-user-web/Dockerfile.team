# Build context: repository root (or a snapshot containing fe-user-web/).
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY fe-user-web/package.json fe-user-web/package-lock.json ./
RUN npm ci
COPY fe-user-web/ ./
ENV VITE_API_BASE_URL=/api \
    VITE_GPS_MAX_AGE_MS=10000 \
    VITE_GPS_MAX_ACCURACY_METERS=50
RUN npm run build

FROM nginx:stable-alpine AS final
COPY fe-user-web/nginx.team.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
