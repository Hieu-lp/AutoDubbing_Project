# Public API prefix. Use the Vite proxy locally; production needs a same-origin /api reverse proxy.
VITE_API_BASE_URL=/api
# Server-side Vite proxy target, never bundled into the browser. TLS verification stays enabled.
API_PROXY_TARGET=https://localhost:7239
# Client trust policy for GPS; proximity/dwell thresholds come from backend settings.
VITE_GPS_MAX_AGE_MS=10000
VITE_GPS_MAX_ACCURACY_METERS=50
