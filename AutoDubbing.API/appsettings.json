{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=AutoDubbingDb;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "AutoDubbing.API",
    "Audience": "AutoDubbing.Admin",
    "LifetimeMinutes": 30
  },
  "OpenRouteService": {
    "TimeoutSeconds": 20
  },
  "Gemini": {
    "TimeoutSeconds": 55,
    "MaxRetries": 2
  },
  "ContentPreparation": {
    "AcceptNewGeneration": false,
    "PreparationRadiusMeters": 500,
    "PlaybackRadiusMeters": 50,
    "DwellSeconds": 3,
    "QueueCapacity": 32,
    "RetainedJobs": 256,
    "JobRetentionMinutes": 30,
    "FailureCooldownMinutes": 5,
    "DailyQuotaCooldownMinutes": 30,
    "JobTimeoutSeconds": 600,
    "ClientRequestsPerMinute": 8,
    "GlobalRequestsPerMinute": 30
  },
  "AllowedHosts": "*"
}
